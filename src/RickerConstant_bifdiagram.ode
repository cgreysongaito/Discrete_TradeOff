#RickerConstant Model
#bifurcation diag of the discrete map f(x)=(x * exp(-α-β*x)) + a-b*exp(-K*(tau+1))*(p^(tau+1))*delay(x,tau)
x'=(x * exp(-alpha-beta*x)) + (a-b*exp(-K*(tau+1)))*(p^(tau+1))*delay(x,tau)
init x=0.5
x(0)=0.5

#Tau bifurcation
#par tau=3.0,alpha=0.1, beta=0.3, a=25.0, b=200, K=1.0, p=0.6
#a bifurction
par a=5.0,tau=3.0,alpha=0.1, beta=0.3, b=200, K=1.0, p=0.6

@ delay=200, total=5000,method=discrete,nout=2
@ autoxmin=0.0,autoxmax=15.0,autoymin=-2,autoymax=2
#tau bifurcation
#@ dsmax=0.05,dsmin=.00001,parmin=0.0,parmax=10.0, ds=1.0
#a bifurcation
@ dsmax=0.05,dsmin=.00001,parmin=0.0,parmax=15.0, ds=0.02

@ maxstor 10000000,npr=10 
@ xlo=0,xhi=5000,ylo=0,yhi=50,xp=t,yp=x
done
