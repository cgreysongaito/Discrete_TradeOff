#RickerBevertonHolt Model
#bifurcation diag 
#tau = 2
x(t+1)=(x * exp(-alpha-beta*x)) + (D/(D*(1+D)^(tau+1)+((1+D)^(tau+1)-1)*(a-b*exp(-K*(tau+1)))*w))*(a-b*exp(-K*(tau+1)))*w
y(t+1)= x
z(t+1)= y
w(t+1)= z
init x=0.5
init y=0.5
init z=0.5
init w=0.5
x(0)=0.5
y(0)=0.5
z(0)=0.5
w(0)=0.5

#When tau=3, lower boundary of a is 3.7

#Can't do tau bifurcation so do a bifurcations
#a bifurction
par a=50.0, tau=3.0, alpha=0.1, beta=0.3, b=200, K=1.0, D=0.1, C=0.1



@ total=5000,method=discrete,nout=2
@ autoxmin=3.7,autoxmax=20.0,autoymin=-0.5,autoymax=15.0
#a bifurcation
@ dsmax=0.05,dsmin=.00001,parmin=3.7,parmax=20.0, ds=0.02

@ maxstor 10000000,npr=10 
@ xlo=0,xhi=5000,ylo=0,yhi=50,xp=t,yp=x
done
