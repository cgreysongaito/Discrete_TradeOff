#RickerRicker Model
#bifurcation diag 
#tau = 15
x(t+1)=(x * exp(-alpha-beta*x)) + exp(-D-C*p)*p
y(t+1)= (a-b*exp(-K*(tau+1))) * exp(-D-C*(a-b*exp(-K*(tau+1)))*x)*x
z(t+1)= exp(-D-C*y)*y
w(t+1)= exp(-D-C*z)*z
u(t+1)= exp(-D-C*w)*w
v(t+1)= exp(-D-C*u)*u
e(t+1) = exp(-D-C*v)*v
f(t+1) = exp(-D-C*e)*e
g(t+1) = exp(-D-C*f)*f
h(t+1) = exp(-D-C*g)*g
i(t+1) = exp(-D-C*h)*h
j(t+1) = exp(-D-C*i)*i
l(t+1) = exp(-D-C*j)*j
m(t+1) = exp(-D-C*l)*l
n(t+1) = exp(-D-C*m)*m
p(t+1) = exp(-D-C*n)*n
init x=10.0
init y=10.0
init z=10.0
init w=10.0
init u=10.0
init v=10.0
init e=10.0
init f=10.0
init g=10.0
init h=10.0
init i=10.0
init j=10.0
init l=10.0
init m=10.0
init n=10.0
init p=10.0
x(0)=10.0
y(0)=10.0
z(0)=10.0
w(0)=10.0
u(0)=10.0
v(0)=10.0
e(0)=10.0
f(0)=10.0
g(0)=10.0
h(0)=10.0
i(0)=10.0
j(0)=10.0
l(0)=10.0
m(0)=10.0
n(0)=10.0
p(0)=10.0

#a bifurcation
par a=5.0, D=0.1, tau=15.0, alpha=0.1, beta=0.3, b=200, K=1.0, C=0.1
#par a=100.0,tau=15.0,alpha=1.5,beta=0.1,D=0.9,C=0.15, K=1.0, b=200.0
#K bifurcation
#par K=1.0, a=5.0, D=0.1, tau=15.0, alpha=0.1, beta=0.3, b=200, C=0.1
#b bifurcation - when a=5.0 b<273
#par b=200, K=1.0, a=25.0, D=0.1, tau=15.0, alpha=0.1, beta=0.3, C=0.1
#C bifurcation 
#par a=5.0, C=0.1, D=0.1, b=200, K=1.0, tau=15.0, alpha=0.1, beta=0.3
#alpha bifurcation
#par a=5.0, alpha=0.1, C=0.1, D=0.1, b=200, K=1.0, tau=15.0, beta=0.3
#beta bifurcation
#par a=5.0, beta=0.3, alpha=0.1, C=0.1, D=0.1, b=200, K=1.0, tau=15.0, 


@ total=10000,method=discrete,nout=1
@ maxstor 10000000 
@ dsmax=0.05,dsmin=.00001, ds=0.02, npr=160, nmax=10000
@ xlo=0,xhi=10000,ylo=0,yhi=50,xp=t,yp=x

#a bifurcation
@ autoxmin=0.0,autoxmax=70.0,autoymin=-0.5,autoymax=15.0, parmin=0.0,parmax=70.0 

#K bifurcation
#@ autoxmin=0.0,autoxmax=30.0,autoymin=-0.5,autoymax=15.0, parmin=0.0,parmax=30.0 

#b bifurcation
#@ autoxmin=0.0,autoxmax=273.0,autoymin=-0.5,autoymax=15.0, parmin=0.0,parmax=273.0 

#alpha, beta, C bifurcation
#@ autoxmin=0.0,autoxmax=70.0,autoymin=-0.5,autoymax=15.0, parmin=0.0,parmax=70.0 

done