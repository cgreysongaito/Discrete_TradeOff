#bif_diag.ode
#bifurcation diag of the discrete map f(x)=cx+c^3
x(t+1)=c*x+x^3 
par c=0
init x=0
@ total=200,method=discrete,nout=2
@ autoxmin=-2.2,autoxmax=1.5,autoymin=-2,autoymax=2
@ dsmax=0.05,dsmin=.00001,parmin=-2.2,parmax=2
@ maxstor 10000000,npr=10 
@ xlo=0,xhi=200,ylo=-3,yhi=3,xp=t,yp=x
done
