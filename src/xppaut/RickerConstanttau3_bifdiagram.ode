#RickerConstant Model
#bifurcation diag of the discrete map f(x)=(x * exp(-α-β*x)) + a-b*exp(-K*(tau+1))*(p^(tau+1))*delay(x,tau)
#tau = 3
x(t+1)=(x * exp(-alpha-beta*x)) + (a-b*exp(-K*(tau+1)))*(p^(tau+1))*w
y(t+1)= x
z(t+1)= y
w(t+1)=z
init x=0.5
init y=0.5
init z=0.5
init w=0.5
x(0)=0.5
y(0)=0.5
z(0)=0.5
w(0)=0.5

#When tau=3,p=0.6 boundaries of a are 5.0, 12.0

#Can't do tau bifurcation so do a and p bifurcations
#a bifurction
#par a=6.0, p=0.7, tau=3.0, alpha=0.1, beta=0.3, b=200, K=1.0
par a=5, p=0.7, tau=3.0, alpha=0.1, beta=0.3, b=200, K=1.0


@ total=10000,method=discrete,nout=2
@ autoxmin=3.5,autoxmax=9.0,autoymin=-0.5,autoymax=15.0
#a bifurcation
@ dsmax=0.001,dsmin=.000001,parmin=3.5,parmax=9.0, ds=0.001, npr=7000, nmax=6000

@ maxstor 10000000 
@ xlo=0,xhi=10000,ylo=0,yhi=50,xp=t,yp=x
done
