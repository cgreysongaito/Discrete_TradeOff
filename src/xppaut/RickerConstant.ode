#RickerConstant Model
#timeseries diag of the discrete map f(x)=(x * exp(-α-β*x)) + a-b*exp(-K*(tau+1))*(p^(tau+1))*delay(x,tau)
#f(x)=(x * exp(-alpha-beta*x)) + (a-b*exp(-K*(tau+1)))*(p^(tau+1))*delay(x,tau)
x'=(x * exp(-alpha-beta*x)) + (a-b*exp(-K*(tau+1)))*(p^(tau+1))*delay(x,tau)
init x=0.5
x(0)=0.5
par alpha=0.1, beta=0.3, a=10.0, b=200, K=1.0, p=0.6, tau=3

@ delay=200, total=200,method=discrete
@ maxstor 10000000,npr=10 
@ xlo=0,xhi=200,ylo=-3,yhi=3,xp=t,yp=x
done