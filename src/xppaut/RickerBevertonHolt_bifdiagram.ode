#RickerBevertonHolt Model
#bifurcation diag 
#tau = 2
x(t+1)=(x * exp(-alpha-beta*x)) + (D/(D*(1+D)^(tau+1)+((1+D)^(tau+1)-1)*(a-b*exp(-K*(tau+1)))*z))*(a-b*exp(-K*(tau+1)))*z
y(t+1)= x
z(t+1)= y
init x=0.5
init y=0.5
init z=0.5
x(0)=0.5
y(0)=0.5
z(0)=0.5

#When tau=2, lower boundary of a is 10.0

#Can't do tau bifurcation so do a bifurcations
#a bifurction
#par a=10.2, tau=2.0, alpha=0.1, beta=0.3, b=200, K=1.0, D=0.1, C=0.1

par alpha=0.1, a=10.2, tau=2.0, beta=0.3, b=200, K=1.0, D=0.1, C=0.1


@ total=5000,method=discrete,nout=2
@ autoxmin=10.0,autoxmax=100.0,autoymin=-0.5,autoymax=15.0
#a bifurcation
@ dsmax=0.05,dsmin=.00001,parmin=10.0,parmax=100.0, ds=0.02

@ maxstor 10000000,npr=10 
@ xlo=0,xhi=5000,ylo=0,yhi=50,xp=t,yp=x
done
