#RickerRicker Model
#bifurcation diagram
#tau = 2
x(t+1)=(x * exp(-alpha-beta*x)) + exp(-D-C*z)*z
y(t+1)= (a-b*exp(-K*(tau+1))) * exp(-D-C*(a-b*exp(-K*(tau+1)))*x)*x
z(t+1)= exp(-D-C*y)*y
init x=10.0
init y=10.0
init z=10.0
x(0)=10.0
y(0)=10.0
z(0)=10.0


#a bifurcation
#par a=12.9, D=0.1, tau=2.0, alpha=0.1, beta=0.3, b=200, K=1.0, C=0.1
#C bifurcation 
#par a=12.9, C=0.1, D=0.1, b=200, K=1.0, tau=2.0, alpha=0.1, beta=0.3
#beta bifurcation
par a=12.9, beta=2.0, alpha=0.1, C=0.3, D=0.1, b=200, K=1.0, tau=2.0, 

@ total=10000,method=discrete,nout=1
@ maxstor 10000000 
@ dsmax=0.05,dsmin=.00001, ds=0.02, npr=160, nmax=10000
@ xlo=0,xhi=10000,ylo=0,yhi=50,xp=t,yp=x

#a bifurcation
@ autoxmin=0.0,autoxmax=70.0,autoymin=-0.5,autoymax=15.0, parmin=0.0,parmax=70.0 
#beta, C bifurcation
@ autoxmin=0.0,autoxmax=70.0,autoymin=-0.5,autoymax=15.0, parmin=0.0,parmax=70.0 

done