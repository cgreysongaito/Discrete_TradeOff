#RickerBevertonHolt Model
#bifurcation diag 
#tau = 5
x(t+1)=(x * exp(-alpha-beta*x)) + (D/(D*(1+D)^(tau+1)+((1+D)^(tau+1)-1)*C*(a-b*exp(-K*(tau+1)))*v))*(a-b*exp(-K*(tau+1)))*v
y(t+1)= x
z(t+1)= y
w(t+1)= z
u(t+1) = w
v(t+1) = u
init x=0.5
init y=0.5
init z=0.5
init w=0.5
init u=0.5
init v=0.5
x(0)=0.5
y(0)=0.5
z(0)=0.5
w(0)=0.5
u(0)=0.5
v(0)=0.5

#a bifurcation
#par a=34.0, D=0.1, tau=5.0, alpha=0.1, beta=1000.0, b=200, K=1.0, C=0.1
#K bifurcation
#par K=1.0, a=5.0, D=0.1, tau=5.0, alpha=0.1, beta=0.3, b=200, C=0.1
#b bifurcation - when a=5.0 b<273
#par b=200, K=1.0, a=25.0, D=0.1, tau=5.0, alpha=0.1, beta=0.3, C=0.1
#C bifurcation 
par a=25.0, C=0.3, D=0.1, b=200, K=1.0, tau=5.0, alpha=0.1, beta=0.3
#alpha bifurcation
#par a=5.0, alpha=0.1, C=0.1, D=0.1, b=200, K=1.0, tau=5.0, beta=0.3
#beta bifurcation
#par a=5.0, beta=0.3, alpha=0.1, C=0.1, D=0.1, b=200, K=1.0, tau=5.0, 

#C, beta bifurcation
#par beta=0.3,C=0.1, a=40.0, D=0.1, b=200, K=1.0, tau=5.0, alpha=0.1


@ total=10000,method=discrete,nout=1
@ maxstor 10000000 
@ dsmax=0.05,dsmin=.00001, ds=0.02, npr=2000, nmax=10000
@ xlo=0,xhi=10000,ylo=0,yhi=50,xp=t,yp=x

#a bifurcation
#@ autoxmin=3.5,autoxmax=60.0,autoymin=-0.5,autoymax=15.0, parmin=3.5,parmax=60.0 

#K bifurcation
#@ autoxmin=0.0,autoxmax=30.0,autoymin=-0.5,autoymax=15.0, parmin=0.0,parmax=30.0 

#b bifurcation
#@ autoxmin=0.0,autoxmax=273.0,autoymin=-0.5,autoymax=15.0, parmin=0.0,parmax=273.0 

#C bifurcation
@ autoxmin=0.0,autoxmax=500.0,autoymin=-0.5,autoymax=15.0, parmin=0.0,parmax=500.0 

#beta C bifurcation
#@ autoxmin=0.0,autoxmax=5.0,autoymin=-0.5,autoymax=15.0, parmin=0.0,parmax=10.0 

done

