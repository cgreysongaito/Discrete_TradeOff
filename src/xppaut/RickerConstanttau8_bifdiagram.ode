#RickerConstant Model
#bifurcation diag of the discrete map f(x)=(x * exp(-α-β*x)) + a-b*exp(-K*(tau+1))*(p^(tau+1))*delay(x,tau)
#tau = 8
x(t+1)=(x * exp(-alpha-beta*x)) + (a-b*exp(-K*(tau+1)))*(p^(tau+1))*l
y(t+1)= x
z(t+1)= y
w(t+1)=z
v(t+1)=w
h(t+1)=v
i(t+1)=h
j(t+1)=i
l(t+1)=j
init x=0.5
init y=0.5
init z=0.5
init w=0.5
init v=0.5
init h=0.5
init i=0.5
init j=0.5
init l=0.5
x(0)=0.5
y(0)=0.5
z(0)=0.5
w(0)=0.5
v(0)=0.5
h(0)=0.5
i(0)=0.5
j(0)=0.5
l(0)=0.5

#Can't do tau bifurcation so do a and p bifurcations
#a bifurction
par a=30.0, p=0.6, tau=8.0, alpha=0.1, beta=0.3, b=200, K=1.0

@ total=5000,method=discrete,nout=1
@ autoxmin=0.0,autoxmax=120.0,autoymin=-0.5,autoymax=15.0
#a bifurcation
@ dsmax=0.02,dsmin=.000001,parmin=0.0,parmax=120.0, ds=0.02, npr=4000, nmax=4500

@ maxstor 10000000 
@ xlo=0,xhi=5000,ylo=0,yhi=50,xp=t,yp=x
done
